# Copiar a .env y completar con valores reales.

# --- Seguridad / JWT ---
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Base de datos ---
DATABASE_URL=sqlite:///./champion_hive_local.db
# Para PostgreSQL: DATABASE_URL=postgresql+psycopg2://usuario:clave@host:5432/champion_hive

# --- Administrador inicial ---
# Se crea automáticamente al arrancar si no existe un usuario con ese email.
# ¡Cambia estos valores en producción!
ADMIN_EMAIL=admin@championhive.com
ADMIN_PASSWORD=admin1234

# --- Mejores jugadas (video) ---
# Los clips van a disco, no a la base. En desarrollo basta con la carpeta
# local (backend/media, ya ignorada por git).
MEDIA_ROOT=./media
MAX_VIDEO_MB=40

# --- Contentful (opcional, APAGADO por defecto) ---
# Sin esto los clips se sirven desde disco y todo funciona igual.
CONTENTFUL_ENABLED=false
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_MANAGEMENT_TOKEN=
