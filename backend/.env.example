# Copiar a .env y completar con valores reales.

# --- Seguridad / JWT ---
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Base de datos ---
DATABASE_URL=sqlite:///./champion_hive_local.db
# Para PostgreSQL: DATABASE_URL=postgresql+psycopg2://usuario:clave@host:5432/champion_hive

# --- Administrador inicial ---
# Se crea automáticamente al arrancar si no existe un usuario con ese email.
# ¡Cambia estos valores en producción!
ADMIN_EMAIL=admin@championhive.com
ADMIN_PASSWORD=admin1234
