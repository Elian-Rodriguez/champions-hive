# ===== Champion Hive — variables de entorno =====
# Copia este archivo a .env (en la carpeta deploy/) y completa los valores.

# --- Seguridad / JWT (backend) ---
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Administrador inicial (se crea al arrancar si no existe) ---
ADMIN_EMAIL=admin@championhive.com
ADMIN_PASSWORD=cambia-esta-clave

# --- Log de la aplicación ---
# DEBUG, INFO, WARNING o ERROR. Sale por stdout (docker logs / supervisor).
LOG_LEVEL=INFO

# --- Correo saliente (recuperación de contraseña) ---
# Sin SMTP_HOST no se envía nada y la plataforma sigue igual: el soporte
# resetea la clave a mano desde el panel de usuarios.
# APP_BASE_URL es de dónde cuelga el enlace que recibe el usuario, así que
# tiene que ser la URL pública del frontend.
APP_BASE_URL=http://localhost:8080
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Champion Hive <no-reply@tudominio.com>
SMTP_STARTTLS=true
# Minutos que vive el enlace de recuperación.
RESET_TOKEN_MINUTES=60

# --- Base de datos ---
# PostgreSQL (recomendado; usa el servicio "db" del docker-compose):
DATABASE_URL=postgresql+psycopg2://champion:champion@db:5432/champion_hive
# SQLite (alternativa de archivo único, persiste en el volumen /data):
# DATABASE_URL=sqlite:////data/champion_hive.db

# --- Credenciales del PostgreSQL del compose (servicio db) ---
POSTGRES_USER=champion
POSTGRES_PASSWORD=champion
POSTGRES_DB=champion_hive

# --- Frontend (se "hornea" en tiempo de build) ---
# En la imagen combinada el frontend llama al backend en el mismo origen:
VITE_API_URL=/api/v1

# --- Publicación del contenedor ---
APP_PORT=8080
# Usar imagen ya publicada en GHCR en lugar de construir localmente:
# IMAGE=ghcr.io/elian-rodriguez/champions-hive:latest
